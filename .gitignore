# deps / build
node_modules/
.next/
dist/
*.tsbuildinfo

# env
.env
.env.*
!.env.example

# local dev database + portable postgres
.pgdata/
tools/

# The root agent guide. Holds the deploy runbook including the host's root password, and this
# repo is public — so it stays local and is never pushed. Anchored with a leading slash: the
# committed apps/web/AGENTS.md (written by `next dev`) must keep tracking normally.
/AGENTS.md
/CLAUDE.md
*.local.md
# Any throwaway probe/test script. These get written next to the code they exercise and
# routinely hold a live connection string — this repo is public.
*.local.*

# Agent scratch. Local-only notes and plans that shouldn't reach the history.
.claude/settings.local.json
scratchpad/

# misc
.DS_Store
Thumbs.db
# Uploaded contract images. Anchored to the two places they actually land (repo root, and
# apps/web when UPLOAD_DIR is unset in dev) — an unanchored `uploads/` also swallows the
# API route source at apps/web/src/app/api/uploads/, which must be committed.
/uploads/
/apps/web/uploads/

# Database dumps taken before migrations on the deploy box. These contain live user
# data — handles, session rows, password hashes — and must never reach the repo.
/backups/
*.sql.gz

