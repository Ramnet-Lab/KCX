# misc
.DS_Store
Thumbs.db
# Uploaded contract images. Anchored to the two places they actually land (repo root, and
# apps/web when UPLOAD_DIR is unset in dev) — an unanchored `uploads/` also swallows the
# API route source at apps/web/src/app/api/uploads/, which must be committed.
/uploads/
/apps/web/uploads/

# Database dumps taken before migrations on the deploy box. These contain live user
# data — handles, session rows, password hashes — and must never reach the repo.
/backups/
*.sql.gz

