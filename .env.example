# Copy to .env and fill in. `pnpm setup` creates this for you with dev defaults.

# --- Database (local dev: portable Postgres or docker-compose.dev.yml, both on 5433) ---
DATABASE_URL=postgres://kcx:kcx@localhost:5433/kcx

# --- UEX Corp API (https://uexcorp.space/api/documentation/) ---
# Reads work unauthenticated; register a free app at uexcorp.space/api/apps for a bearer token.
UEX_API_BASE=https://api.uexcorp.uk/2.0
UEX_API_TOKEN=

# --- Realtime (socket.io server in apps/server) ---
WS_PORT=4000
WEB_ORIGINS=http://localhost:3000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# --- Auth ---
# Salts the hashed IPs stored against sessions. Any random string; never share it.
IP_HASH_SALT=change-me
# Dev-only handle sign-in. The API refuses this when NODE_ENV=production regardless.
ALLOW_DEV_LOGIN=true
# WebAuthn relying-party ID: bare domain, no scheme or port. Passkeys bind to it
# permanently, so changing it later invalidates every enrolled credential.
RP_ID=localhost

# =====================================================================
# Production only (docker-compose.yml). Leave blank for local dev.
# =====================================================================

# Domain Caddy requests a TLS certificate for. Must already resolve to this server.
KCX_DOMAIN=
# Full public origin — used for CORS and as the browser's socket target.
PUBLIC_ORIGIN=
# Postgres credentials for the db container. REQUIRED: there is no default password.
POSTGRES_USER=kcx
POSTGRES_PASSWORD=
POSTGRES_DB=kcx

# Prebuilt images to run instead of building on the box (set by CI).
KCX_IMAGE_WEB=
KCX_IMAGE_SERVER=
